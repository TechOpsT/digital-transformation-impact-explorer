{
  "openapi": "3.1.0",
  "info": {
    "title": "Assessment Service API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [],
  "paths": {
    "/api/v1/assessments": {
      "post": {
        "summary": "Start an anonymous assessment",
        "operationId": "createAssessment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "questionnaireVersion"
                ],
                "properties": {
                  "questionnaireVersion": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Assessment started",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Assessment"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/assessments/{assessmentId}": {
      "get": {
        "summary": "Get assessment progress",
        "operationId": "getAssessment",
        "parameters": [
          {
            "$ref": "#/components/parameters/AssessmentId"
          }
        ],
        "responses": {
          "200": {
            "description": "Assessment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Assessment"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/assessments/{assessmentId}/responses": {
      "post": {
        "summary": "Upsert assessment responses",
        "operationId": "submitResponses",
        "parameters": [
          {
            "$ref": "#/components/parameters/AssessmentId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "responses"
                ],
                "properties": {
                  "responses": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/components/schemas/Response"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Responses accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Assessment"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/assessments/{assessmentId}/complete": {
      "post": {
        "summary": "Complete an assessment idempotently",
        "operationId": "completeAssessment",
        "parameters": [
          {
            "$ref": "#/components/parameters/AssessmentId"
          }
        ],
        "responses": {
          "200": {
            "description": "Idempotent completed result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/assessments/{assessmentId}/results": {
      "get": {
        "summary": "Get an immutable assessment result",
        "operationId": "getResult",
        "parameters": [
          {
            "$ref": "#/components/parameters/AssessmentId"
          }
        ],
        "responses": {
          "200": {
            "description": "Completed result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "summary": "Check process liveness",
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Health"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Check service readiness",
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Health"
          },
          "503": {
            "$ref": "#/components/responses/Health"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Expose Prometheus metrics",
        "operationId": "getMetrics",
        "responses": {
          "200": {
            "description": "Prometheus metrics",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "AssessmentId": {
        "name": "assessmentId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Machine-readable error",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Health": {
        "description": "Health state",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Health"
            }
          }
        }
      }
    },
    "schemas": {
      "Assessment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "questionnaireVersion",
          "status",
          "responses",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "questionnaireVersion": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "started",
              "completed"
            ]
          },
          "responses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Response"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "questionId",
          "optionId"
        ],
        "properties": {
          "questionId": {
            "type": "string"
          },
          "optionId": {
            "type": "string"
          }
        }
      },
      "Result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assessmentId",
          "questionnaireVersion",
          "scoringVersion",
          "recommendationRuleSetVersion",
          "overallScore",
          "maturityLevel",
          "dimensionScores",
          "recommendations",
          "completedAt"
        ],
        "properties": {
          "assessmentId": {
            "type": "string",
            "format": "uuid"
          },
          "questionnaireVersion": {
            "type": "string"
          },
          "scoringVersion": {
            "type": "string"
          },
          "recommendationRuleSetVersion": {
            "type": "string"
          },
          "overallScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "multipleOf": 0.1
          },
          "maturityLevel": {
            "type": "string",
            "enum": [
              "Initial",
              "Emerging",
              "Developing",
              "Established",
              "Optimizing"
            ]
          },
          "dimensionScores": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "$ref": "#/components/schemas/DimensionScore"
            }
          },
          "recommendations": {
            "type": "array",
            "minItems": 3,
            "maxItems": 5,
            "items": {
              "$ref": "#/components/schemas/Recommendation"
            }
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DimensionScore": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimensionId",
          "raw",
          "possible",
          "normalized",
          "weight"
        ],
        "properties": {
          "dimensionId": {
            "type": "string"
          },
          "raw": {
            "type": "integer",
            "minimum": 0
          },
          "possible": {
            "type": "integer",
            "minimum": 1
          },
          "normalized": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        }
      },
      "Recommendation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ruleId",
          "dimensionId",
          "triggerScore",
          "priority",
          "rationale",
          "action"
        ],
        "properties": {
          "ruleId": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "dimensionId": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "triggerScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "type",
          "title",
          "status",
          "code",
          "requestId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri-reference"
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "detail",
                "pointer"
              ],
              "properties": {
                "detail": {
                  "type": "string"
                },
                "pointer": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
